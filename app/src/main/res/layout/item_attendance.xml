<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Заголовок группы: показывается только над первым студентом группы -->
    <LinearLayout
        android:id="@+id/groupHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="?attr/colorPrimary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvGroupHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/student_card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Имя студента с акцентной полоской слева -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="36dp"
                    android:background="@color/amber_600"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvAttendanceStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/student_card_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Разделитель внутри карточки -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/student_card_divider"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPresent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Присутствовал"
                    android:textColor="@color/student_card_title"
                    android:buttonTint="@color/indigo_100"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbAbsent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отсутствовал"
                    android:textColor="@color/student_card_title"
                    android:buttonTint="@color/delete_button"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbLate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Опоздал"
                    android:textColor="@color/student_card_title"
                    android:buttonTint="@color/amber_600"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
